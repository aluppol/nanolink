{
  "name": "nanolink-redirect",
  "version": "1.0.0",
  "private": true,
  "description": "NanoLink redirect service: short code to 302 through a read-through cache",
  "license": "AGPL-3.0-only",
  "author": "Albert Luppol",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "check:comments": "tsx scripts/checkComments.ts src test scripts",
    "check": "npm run lint && npm run typecheck && npm run check:comments && npm run test"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
